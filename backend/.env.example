# ===========================================
# The Candle Tales — Environment Variables
# ===========================================

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/the_candle_tales
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT Authentication (minimum 64 characters)
JWT_SECRET=your_jwt_secret_must_be_at_least_64_characters_long_for_hmac_sha

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS — Frontend URL
FRONTEND_URL=https://your-frontend-domain.com

# Spring Profile (set to 'prod' for production)
SPRING_PROFILES_ACTIVE=prod

# Admin Default Password (used only for initial seeding)
ADMIN_DEFAULT_PASSWORD=change_this_immediately
